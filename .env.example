# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-random-secret

# Published on host loopback for reverse proxy. Change if the port is occupied.
WECHAT_PORT=13304
WECHAT_DATA_DIR=/opt/wechat-server/data
WECHAT_IMAGE_TAG=local

# Optional: omit/leave empty to use SQLite at /data/wechat-server.db.
# MySQL DSN format: user:password@tcp(host.docker.internal:3306)/wechat_server?charset=utf8mb4&parseTime=True&loc=Local
SQL_DSN=

# Optional Redis URL. Omit/leave empty to disable Redis.
# Example: redis://:password@host.docker.internal:6379/0
REDIS_CONN_STRING=
